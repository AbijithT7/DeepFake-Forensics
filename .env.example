# ==============================================================================
# DeepFake Forensics - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' and adjust the values according to your local environment.
# WARNING: Do not store actual production secrets or private API keys in this template.

# Application Settings
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Compute / Hardware Settings
# Options: cuda, cpu
DEVICE=cuda
CUDA_VISIBLE_DEVICES=0

# Storage Paths
DATASET_RAW_DIR=./datasets/raw
DATASET_PROCESSED_DIR=./datasets/processed
MODEL_STORAGE_DIR=./models
OUTPUT_DIR=./outputs

# Detection & Inference Thresholds
DETECTION_THRESHOLD=0.5
BATCH_SIZE=16

# Security / API Authentication (Placeholders only)
API_SECRET_KEY=replace_with_your_secure_random_key_in_local_env
