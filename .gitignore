# ==============================================================================
# SECRETS AND CREDENTIALS
# ==============================================================================
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
service-account*.json

# ==============================================================================
# PYTHON ENVIRONMENT & CACHES
# ==============================================================================
.venv/
.venv*/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.cache/
*.cache/
matplotlib_cache/

# ==============================================================================
# EDITOR AND OS FILES
# ==============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
.DS_Store
Thumbs.db
desktop.ini

# ==============================================================================
# DATASETS & EXPERIMENTS
# ==============================================================================
evaluation_dataset/
evaluation_results/
experiments/
datasets/evaluation_benchmark/
datasets/downloaded/
datasets/raw/*
!datasets/raw/.gitkeep
datasets/processed/*
!datasets/processed/.gitkeep

# Exclude router dataset images while preserving manifest
datasets/image_type_router/images/
!datasets/image_type_router/manifest.csv

# ==============================================================================
# MODEL CHECKPOINTS & DOWNLOAD CACHES
# ==============================================================================
# Downloaded HuggingFace model hub caches (auto-downloadable via download_pretrained.py)
models/huggingface/
models/community_forensics/
models/image_type_encoder/.cache/
models/deepguard/.cache/

# Intermediate feature embeddings (can be regenerated from manifest)
models/image_type_router/*.npz

# Experimental & scratch checkpoints
checkpoints/
models/experimental/
*.ckpt

# ==============================================================================
# TEMPORARY LOGS, DEBUGGING & RUNTIME SESSIONS
# ==============================================================================
*.log
logs/
*.tmp
tests/tmp*

outputs/gradcam/*
!outputs/gradcam/.gitkeep
outputs/web_sessions/*
!outputs/web_sessions/.gitkeep
outputs/web_history.json
outputs/test_crops/*
!outputs/test_crops/.gitkeep
outputs/diagnostics/*
!outputs/diagnostics/.gitkeep
